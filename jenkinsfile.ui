pipeline {
    agent any

    stages {

   stage('Clean workspace') {
            steps {
                deleteDir()
            }
        }

stage('Clone repository') {
    steps {
        git branch: 'playwright_project',
            url: 'https://github.com/peter-stefanski/Playwright_tests.git'
    }
}

        stage('Install dependencies') {
            steps {
                bat 'npm ci'
            }
        }

        stage('Install Playwright') {
            steps {
                bat 'npx playwright install'
            }
        }

        stage('Run UI Tests') {
            steps {
                bat 'npm run test:ui'
            }
        }
    }
}